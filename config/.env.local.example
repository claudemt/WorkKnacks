# WorkKnacks 本机配置示例。复制为 .env.local，或直接使用 GUI 的“配置”按钮。
DEFAULT_PROVIDER_PARSE=mineru
DEFAULT_PROVIDER_TRANSLATE=deepl_oneshot

# MinerU 标准 extract。也可运行：mineru-open-api auth
MINERU_TOKEN=

# 翻译服务：deepl_oneshot / local_translate / tencent_tmt / baidu
LOCAL_TRANSLATE_ENDPOINT=http://127.0.0.1:8000/translate
LOCAL_TRANSLATE_TIMEOUT=60
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
BAIDU_APP_ID=
BAIDU_KEY=
DEEPL_IOS_APP_BUILD=5443737
