# ----------------------------------------------------------------
# WorkKnacks 密钥配置
# 复制此文件为 .env.local 并填入你的密钥。
# .env.local 已在 .gitignore 中，不会被提交。
# ----------------------------------------------------------------

# --- 翻译：DeepL (免费，oneshot iOS 端点) ---
# 无需 API key。
DEEPL_IOS_APP_BUILD=5443737

# --- 翻译：腾讯云机器翻译 TMT ---
# 免费额度：500 万字符/月
# 获取方式：https://console.cloud.tencent.com/cam/capi
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# --- 翻译：百度通用文本翻译 ---
# 免费额度：100 万字符/月
# 获取方式：https://fanyi-api.baidu.com/api/trans/product/index
BAIDU_APP_ID=
BAIDU_KEY=

# --- 文档解析：MinerU ---
# 获取方式：https://mineru.net/apiManage/token
MINERU_TOKEN=

# --- 音视频转写：腾讯会议 ---
WEMEET_CORP_ID=210008052

# --- 默认供应商 ---
DEFAULT_PROVIDER_TRANSLATE=deepl_oneshot
DEFAULT_PROVIDER_TRANSCRIBE=wemeet
DEFAULT_PROVIDER_PARSE=mineru
